# Local development only. Replace every CHANGE_ME value before starting.
# Do not use these placeholders or the bundled stack in production.
DEBUG=True
SECRET_KEY=CHANGE_ME_GENERATE_DJANGO_SECRET
FIELD_ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY
ALLOWED_HOSTS=localhost,127.0.0.1

# These credentials initialize a new PostgreSQL data directory.
POSTGRES_DB=reporthub
POSTGRES_USER=reporthub
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Optional separately provisioned application identities (set both values).
# APP_POSTGRES_USER=reporthub_app
# APP_POSTGRES_PASSWORD=CHANGE_ME_APP_POSTGRES_PASSWORD

# Required only with docker-compose.migrations.yml. Provision this role separately.
# MIGRATION_POSTGRES_USER=reporthub_migrator
# MIGRATION_POSTGRES_PASSWORD=CHANGE_ME_MIGRATION_POSTGRES_PASSWORD

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# The ClickHouse server and ReportHub both read this value.
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
# APP_CLICKHOUSE_USER=reporthub_app
# APP_CLICKHOUSE_PASSWORD=CHANGE_ME_APP_CLICKHOUSE_PASSWORD

# MinIO server and Django storage must use matching credentials.
MINIO_ROOT_USER=reporthub
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_STORAGE_ACCESS_KEY=reporthub
MINIO_STORAGE_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_STORAGE_ENDPOINT=minio:9000
MINIO_STORAGE_BUCKET_NAME=reporthub-reports
AWS_STORAGE_BUCKET_NAME=reporthub-reports

# Bundled CDC services and worker concurrency.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONNECT_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONNECT_URL=http://debezium-connect:8083
CDC_WORKER_CONCURRENCY=2
BATCH_WORKER_CONCURRENCY=2

# CDC-to-batch cutover is experimental and must remain disabled.
CDC_EXTERNAL_OPERATION_TRACKING=False
CDC_TO_BATCH_EXECUTOR_ENABLED=False
CDC_TO_BATCH_GENERATION_EXECUTOR_ENABLED=False

# Test SFTP server (tests/docker-compose.test.yml); private keys stay outside Git.
# SFTP_TEST_PORT=2222
# SFTP_TEST_KEY_DIR=/absolute/path/outside/the/repository/sftp-test
