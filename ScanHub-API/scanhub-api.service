[Unit]
Description=Internal ScanHub API
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
LimitNOFILE=65535

User=scanhub
Group=scanhub
SupplementaryGroups=clamav

WorkingDirectory=/home/ScanHub-API
ExecStart=/home/ScanHub-API/https_run.sh

Restart=always
RestartSec=5

TimeoutStartSec=120
TimeoutStopSec=30

KillSignal=SIGTERM

Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target